{
  "name": "multi-messenger",
  "version": "1.3.17",
  "description": "Multi-service messenger with per-service proxy support",
  "author": "nissay87",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:msi": "electron-builder --win msi"
  },
  "dependencies": {
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.multimessenger",
    "productName": "MultiMessenger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!docs/**",
      "!README.md",
      "!.gitignore"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiMessenger"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true
    }
  },
  "homepage": "https://nissay87.github.io/MultiMessenger/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nissay87/MultiMessenger.git"
  },
  "bugs": {
    "url": "https://github.com/nissay87/MultiMessenger/issues"
  }
}
