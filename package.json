{
  "name": "multi-messenger",
  "version": "1.3.24",
  "description": "Multi-service messenger with per-service proxy support",
  "author": "nissay87",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:msi": "electron-builder --win msi",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz"
  },
  "dependencies": {
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.multimessenger",
    "productName": "MultiMessenger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!docs/**",
      "!README.md",
      "!.gitignore"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiMessenger"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "MultiMessenger"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network;InstantMessaging;",
      "maintainer": "nissay87 <y.allivand@gmail.com>",
      "synopsis": "Multi-service messenger with a proxy for each service",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "homepage": "https://nissay87.github.io/multimessenger/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nissay87/MultiMessenger.git"
  },
  "bugs": {
    "url": "https://github.com/nissay87/MultiMessenger/issues"
  }
}
